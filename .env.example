# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional local PostgreSQL / Drizzle connection
# Replace YOUR_POSTGRES_PASSWORD with the actual postgres user's password.
# URL-encode special characters in the password (for example @ becomes %40).
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/app_db
# POSTGRES_PASSWORD is only useful if your tooling builds DATABASE_URL from it.
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
